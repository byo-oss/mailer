{
  "name": "@byo-oss/mailer",
  "version": "0.1.1",
  "description": "A tiny email-sender interface for better-auth plugins, with Wraps, SES and email-sdk adapters and a test suite.",
  "license": "MIT",
  "author": "Jarod Stewart",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wraps": {
      "types": "./dist/wraps.d.ts",
      "import": "./dist/wraps.js",
      "require": "./dist/wraps.cjs"
    },
    "./email-sdk": {
      "types": "./dist/email-sdk.d.ts",
      "import": "./dist/email-sdk.js",
      "require": "./dist/email-sdk.cjs"
    },
    "./ses": {
      "types": "./dist/ses.d.ts",
      "import": "./dist/ses.js",
      "require": "./dist/ses.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "keywords": [
    "better-auth",
    "byo",
    "email",
    "email-sdk",
    "mailer",
    "ses",
    "wraps"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/byo-oss/mailer"
  },
  "homepage": "https://github.com/byo-oss/mailer#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@aws-sdk/client-sesv2": "^3.527.0",
    "@opencoredev/email-sdk": "^3.0.0",
    "@wraps.dev/email": ">=0.15.0",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@opencoredev/email-sdk": {
      "optional": true
    },
    "@wraps.dev/email": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1153.0",
    "@biomejs/biome": "^2.5.15",
    "@opencoredev/email-sdk": "^3.0.0",
    "@types/node": "^22",
    "@wraps.dev/email": "^0.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9",
    "vitest": "^4.1.10"
  }
}
